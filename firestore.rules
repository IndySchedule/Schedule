rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function allowedSettingsKeys() {
      return [
        'toastIconEnabled', 'fontFamily', 'theme', 'showPeriodTimes',
        'lunchWave', 'progressBarEnabled', 'progressBarColor',
        'progressBarOpacity', 'gradientSettings', 'currentScheduleName',
        'indyScheduleOverride_v1', 'indyOnboardingComplete_v2',
        'indyAnalyticsConsent_v1', 'indyReleaseNotice_v1_3_3', 'indyReleaseNotice_v1_3_4', 'indyReleaseNotice_v1_3_5', 'indyReleaseNotice_v1_4_0',
        'sawUpdateNotice', 'indySchoologyPromptSeen_v1', 'periodRenames', 'globalPeriodNames'
      ];
    }

    function validSettings(settings) {
      return settings is map
        && settings.keys().hasOnly(allowedSettingsKeys())
        && settings.get('toastIconEnabled', 'false') in ['true', 'false']
        && settings.get('fontFamily', '') is string && settings.get('fontFamily', '').size() <= 80
        && settings.get('theme', '') is string && settings.get('theme', '').size() <= 24
        && settings.get('showPeriodTimes', 'true') in ['true', 'false']
        && settings.get('lunchWave', 'A') in ['A', 'B', 'C']
        && settings.get('progressBarEnabled', 'true') in ['true', 'false']
        && settings.get('progressBarColor', '#000000') is string
        && settings.get('progressBarColor', '#000000').matches('^#[0-9A-Fa-f]{6}$')
        && settings.get('progressBarOpacity', '0') is string && settings.get('progressBarOpacity', '0').size() <= 5
        && settings.get('gradientSettings', '') is string && settings.get('gradientSettings', '').size() <= 6000
        && settings.get('currentScheduleName', 'normal') in ['normal', 'normalNoSoar', 'lateStart', 'halfDay']
        && (!('indyScheduleOverride_v1' in settings) || settings.indyScheduleOverride_v1 == null
          || (settings.indyScheduleOverride_v1 is map
            && settings.indyScheduleOverride_v1.keys().hasOnly(['date', 'schedule'])
            && settings.indyScheduleOverride_v1.date is string
            && settings.indyScheduleOverride_v1.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && settings.indyScheduleOverride_v1.schedule is string
            && settings.indyScheduleOverride_v1.schedule in ['normal', 'normalNoSoar', 'lateStart', 'halfDay']))
        && settings.get('indyOnboardingComplete_v2', 'false') in ['true', 'false']
        && settings.get('indyAnalyticsConsent_v1', 'denied') in ['granted', 'denied']
        && settings.get('indyReleaseNotice_v1_3_3', 'false') in ['true', 'false']
        && settings.get('indyReleaseNotice_v1_3_4', 'false') in ['true', 'false']
        && settings.get('indyReleaseNotice_v1_3_5', 'false') in ['true', 'false']
        && settings.get('indyReleaseNotice_v1_4_0', 'false') in ['true', 'false']
        && settings.get('sawUpdateNotice', 'false') in ['true', 'false']
        && settings.get('indySchoologyPromptSeen_v1', 'false') in ['true', 'false']
        && settings.get('periodRenames', {}) is map && settings.get('periodRenames', {}).keys().size() <= 100
        && settings.get('globalPeriodNames', {}) is map && settings.get('globalPeriodNames', {}).keys().size() <= 100;
    }

    function validSettingsDocument(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'revision', 'updatedAt', 'updatedBy',
          'settingsUpdatedAt', 'settings', 'unrelatedAccountData'
        ])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy.size() <= 128
        && request.resource.data.settingsUpdatedAt is map
        && request.resource.data.settingsUpdatedAt.keys().hasOnly(request.resource.data.settings.keys())
        && validSettings(request.resource.data.settings);
    }

    // Temporary compatibility for older account docs and partial writes from
    // older clients. Owner isolation still applies and the next v2 save repairs
    // the document in a single transaction.
    function validLegacySettingsDocument(userId) {
      return isOwner(userId)
        && !('schemaVersion' in request.resource.data)
        && request.resource.data.keys().hasOnly(['settings'])
        && validSettings(request.resource.data.settings);
    }

    function validRevisionTransition(userId) {
      return ((!exists(/databases/$(database)/documents/users/$(userId))
          || !('schemaVersion' in resource.data)
          || resource.data.schemaVersion != 2
          || !('revision' in resource.data)
          || !(resource.data.revision is int)
          || resource.data.revision < 1)
        && request.resource.data.revision == 1)
        || (resource.data.schemaVersion == 2
          && resource.data.revision is int
          && request.resource.data.revision == resource.data.revision + 1);
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow write: if validLegacySettingsDocument(userId)
        || (validSettingsDocument(userId) && validRevisionTransition(userId));

      match /musicStats/{statsDocument} {
        allow read, write: if isOwner(userId) && statsDocument == 'summary';

        match /{statsCollection}/{statsEntry} {
          allow read, write: if isOwner(userId)
            && statsCollection in ['songs', 'artists', 'playlists', 'recent', 'daily', 'syncBatches'];
        }
      }

      match /{nestedDocument=**} {
        allow read, write: if false;
      }
    }

    // Guest submissions preserve the account-optional site experience.
    // Enable App Check enforcement as described in docs/feedback-setup.md.
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasAll([
          'category', 'message', 'name', 'email', 'uid', 'createdAt',
          'status', 'pageUrl', 'appVersion'
        ])
        && request.resource.data.keys().hasOnly([
          'category', 'message', 'name', 'email', 'uid', 'createdAt',
          'status', 'pageUrl', 'appVersion'
        ])
        && request.resource.data.category in ['schedule', 'bug', 'suggestion', 'account', 'other']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.message.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && (request.resource.data.email == '' || request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$'))
        && request.resource.data.uid is string
        && ((request.auth == null && request.resource.data.uid == '')
          || (request.auth != null && request.resource.data.uid == request.auth.uid))
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new'
        && request.resource.data.pageUrl is string && request.resource.data.pageUrl.size() <= 2048
        && request.resource.data.pageUrl.matches('^https?://[^?#]*$')
        && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 32;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
