rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function allowedSettingsKeys() {
      return [
        'toastIconEnabled', 'fontFamily', 'theme', 'showPeriodTimes',
        'lunchWave', 'progressBarEnabled', 'progressBarColor',
        'progressBarOpacity', 'gradientSettings', 'currentScheduleName',
        'indyScheduleOverride_v1', 'indyOnboardingComplete_v2',
        'indyAnalyticsConsent_v1', 'indyReleaseNotice_v1_3_3', 'indyReleaseNotice_v1_3_4',
        'sawUpdateNotice', 'periodRenames', 'globalPeriodNames'
      ];
    }

    function validSettings(settings) {
      return settings is map
        && settings.keys().hasOnly(allowedSettingsKeys())
        && (!('toastIconEnabled' in settings) || settings.toastIconEnabled is string)
        && (!('fontFamily' in settings) || (settings.fontFamily is string && settings.fontFamily.size() <= 80))
        && (!('theme' in settings) || (settings.theme is string && settings.theme.size() <= 24))
        && (!('showPeriodTimes' in settings) || settings.showPeriodTimes is string)
        && (!('lunchWave' in settings) || (settings.lunchWave is string && settings.lunchWave in ['A', 'B', 'C']))
        && (!('progressBarEnabled' in settings) || settings.progressBarEnabled is string)
        && (!('progressBarColor' in settings) || (settings.progressBarColor is string && settings.progressBarColor.matches('^#[0-9A-Fa-f]{6}$')))
        && (!('progressBarOpacity' in settings) || (settings.progressBarOpacity is string && settings.progressBarOpacity.size() <= 5))
        && (!('gradientSettings' in settings) || (settings.gradientSettings is string && settings.gradientSettings.size() <= 6000))
        && (!('currentScheduleName' in settings) || (settings.currentScheduleName is string && settings.currentScheduleName in ['normal', 'normalNoSoar', 'lateStart', 'halfDay']))
        && (!('indyScheduleOverride_v1' in settings) || settings.indyScheduleOverride_v1 == null
          || (settings.indyScheduleOverride_v1 is map
            && settings.indyScheduleOverride_v1.keys().hasOnly(['date', 'schedule'])
            && settings.indyScheduleOverride_v1.date is string
            && settings.indyScheduleOverride_v1.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && settings.indyScheduleOverride_v1.schedule is string
            && settings.indyScheduleOverride_v1.schedule in ['normal', 'normalNoSoar', 'lateStart', 'halfDay']))
        && (!('indyOnboardingComplete_v2' in settings) || settings.indyOnboardingComplete_v2 is string)
        && (!('indyAnalyticsConsent_v1' in settings) || (settings.indyAnalyticsConsent_v1 is string && settings.indyAnalyticsConsent_v1 in ['granted', 'denied']))
        && (!('indyReleaseNotice_v1_3_3' in settings) || settings.indyReleaseNotice_v1_3_3 is string)
        && (!('indyReleaseNotice_v1_3_4' in settings) || settings.indyReleaseNotice_v1_3_4 is string)
        && (!('sawUpdateNotice' in settings) || settings.sawUpdateNotice is string)
        && (!('periodRenames' in settings) || (settings.periodRenames is map && settings.periodRenames.keys().size() <= 100))
        && (!('globalPeriodNames' in settings) || (settings.globalPeriodNames is map && settings.globalPeriodNames.keys().size() <= 100));
    }

    function validSettingsDocument(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'revision', 'updatedAt', 'updatedBy',
          'settingsUpdatedAt', 'settings', 'unrelatedAccountData'
        ])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy.size() <= 128
        && request.resource.data.settingsUpdatedAt is map
        && request.resource.data.settingsUpdatedAt.keys().hasOnly(allowedSettingsKeys())
        && validSettings(request.resource.data.settings);
    }

    // Temporary compatibility for older account docs and partial writes from
    // older clients. Owner isolation still applies and the next v2 save repairs
    // the document in a single transaction.
    function validLegacySettingsDocument(userId) {
      return isOwner(userId)
        && !('schemaVersion' in request.resource.data)
        && request.resource.data.keys().hasOnly(['settings'])
        && validSettings(request.resource.data.settings);
    }

    function validRevisionTransition(userId) {
      return ((!exists(/databases/$(database)/documents/users/$(userId))
          || !('schemaVersion' in resource.data)
          || resource.data.schemaVersion != 2
          || !('revision' in resource.data)
          || !(resource.data.revision is int)
          || resource.data.revision < 1)
        && request.resource.data.revision == 1)
        || (resource.data.schemaVersion == 2
          && resource.data.revision is int
          && request.resource.data.revision == resource.data.revision + 1);
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow write: if validLegacySettingsDocument(userId)
        || (validSettingsDocument(userId) && validRevisionTransition(userId));

      match /{nestedDocument=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
