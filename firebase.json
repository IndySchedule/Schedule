{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "target": "production",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      ".firebaserc",
      ".firebase/**",
      ".git/**",
      ".github/**",
      ".gitignore",
      ".DS_Store",
      "**/.DS_Store",
      "**/.*",
      "**/node_modules/**",
      "assets/special-editions/*-master.png",
      "package.json",
      "package-lock.json",
      "README.md",
      "LICENSE",
      "tests/**",
      "tools/**",
      "docs/**"
    ],
    "headers": [
      {
        "source": "/service-worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/data/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
