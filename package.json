{
  "name": "indy-schedule-calendar-sync",
  "version": "1.3.4",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tools/run-regression.mjs",
    "test:firestore-rules": "firebase emulators:exec --only firestore --project indy-schedule-rules-test \"node tests/firestore-rules-test.mjs\"",
    "test:browser": "node tools/visual-qa.mjs",
    "test:visual": "node tools/visual-qa.mjs",
    "check:performance": "node tools/check-performance-budget.mjs",
    "qa": "npm test && npm run validate-live-data && npm run check:performance && npm run test:visual",
    "release:check": "npm run qa && npm run test:firestore-rules",
    "update-calendar": "node tools/update-calendar-events.mjs",
    "update-lunch": "node tools/update-lunch-menu.mjs",
    "validate-live-data": "node tools/validate-live-data.mjs",
    "refresh-live-data": "npm run update-calendar && npm run update-lunch && npm run validate-live-data"
  },
  "dependencies": {
    "node-ical": "0.27.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "firebase": "12.3.0",
    "firebase-tools": "15.28.2",
    "pdfjs-dist": "5.4.149"
  },
  "engines": {
    "node": ">=24"
  }
}
